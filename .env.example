# ClipDish environment variables.
# Copy to .env.local for local dev; set the same in your host (e.g. Vercel →
# Project → Settings → Environment Variables). .env.local is git-ignored.

# --- Extraction (required for the paste-a-link feature to work) ---

# Which LLM provider structures the recipe: "gemini" (default) or "anthropic".
# FOODIE_EXTRACT_PROVIDER=gemini

# Google AI Studio key — REQUIRED when using the default gemini provider.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model override (defaults to gemini-3.6-flash).
# FOODIE_GEMINI_MODEL=gemini-3.6-flash

# --- Only needed if FOODIE_EXTRACT_PROVIDER=anthropic ---
# ANTHROPIC_API_KEY=
# FOODIE_ANTHROPIC_MODEL=claude-haiku-4-5

# --- Scraping proxy (required in cloud hosting; leave blank locally) ---
# YouTube / recipe sites block datacenter IPs, so on Vercel etc. the server
# fetches must route through a residential-IP proxy. With no key the app fetches
# directly (fine on your home connection). Get a free key at scraperapi.com.
SCRAPER_API_KEY=

